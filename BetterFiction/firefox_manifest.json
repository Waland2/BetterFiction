{
    "name": "BetterFiction - FanFiction.net improver",
    "version": "1.4.0",
    "manifest_version": 3,
    "description": "BetterFiction - Extension to improve the experience of using the site fanfiction.net",
    "author": "Waland2 & shahaadi",
    "icons": {
        "16": "icons/ava.svg",
        "32": "icons/ava.svg",
        "128": "icons/ava.svg"
    },
    "permissions": ["storage", "unlimitedStorage", "activeTab"],
    "background": {
        "scripts": ["background.js"],
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://www.fanfiction.net/*", "https://m.fanfiction.net/*"],
            "run_at": "document_start",
            "js": ["dark-mode.js"]
        },
        {
            "matches": ["https://www.fanfiction.net/*"],
            "run_at": "document_end",
            "js": ["content-script.js"]
        },
        {
            "matches": ["https://m.fanfiction.net/*"],
            "run_at": "document_end",
            "js": ["mobile.js"]
        },
        {
            "matches": ["https://archiveofourown.org/*"],
            "run_at": "document_end",
            "js": ["ao3.js"]
        }
    ],
    "host_permissions": ["https://www.fanfiction.net/*", "https://m.fanfiction.net/*", "https://archiveofourown.org/*"],
    "web_accessible_resources": [
        {
            "resources": ["icons/*", "utils/*", "tabs/*"],
            "matches": ["https://www.fanfiction.net/*", "https://m.fanfiction.net/*"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "addon@BetterFiction.com"
        }
    }
}
